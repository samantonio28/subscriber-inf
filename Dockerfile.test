# Тестовый контейнер для CI/CD (ЛР №2).
#
# Требование ЛР №2: запуск тестов оформляется отдельным docker-контейнером,
# который выкачивает код, устанавливает зависимости и средства запуска тестов,
# и вызывается внутри CI/CD. Этот образ содержит:
#   - Go-окружение (версия из go.mod);
#   - postgresql-client — для применения миграций к сервису postgres в CI;
#   - gotestsum — формирует JUnit-отчёты (GitLab показывает их и строит тренды);
#   - allure — генерация отчётов с историей (тренды между запусками).
FROM golang:1.25-alpine

WORKDIR /app

RUN apk add --no-cache postgresql-client openjdk17-jre curl bash

# gotestsum → JUnit XML (интеграция с GitLab test reports + тренды).
RUN go install gotest.tools/gotestsum@latest

# Allure commandline → отчёты с историей (тренды поведения тестов).
ARG ALLURE_VERSION=2.30.0
RUN curl -fsSL -o /tmp/allure.tgz \
      "https://github.com/allure-framework/allure2/releases/download/${ALLURE_VERSION}/allure-${ALLURE_VERSION}.tgz" \
    && tar -xzf /tmp/allure.tgz -C /opt \
    && ln -s "/opt/allure-${ALLURE_VERSION}/bin/allure" /usr/local/bin/allure \
    && rm /tmp/allure.tgz

# Кэшируем зависимости проекта (пересборка слоя только при изменении go.mod/go.sum).
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Генерируем код из OpenAPI (internal/api, pkg/clients/api). Эти каталоги в
# .gitignore и не коммитятся, поэтому свежий git clone их не содержит — без них
# сборка/тесты упадут. Здесь они генерируются прямо в образ.
# ВАЖНО: `go generate` (без ./...) — только корневой пакет, где лежат директивы
# oapi-codegen. `go generate ./...` дополнительно запустил бы mockgen в
# internal/domain (он не установлен и не нужен — моки уже закоммичены).
RUN go generate
