# Пример окружения для стенда WebLab #5.
# Скопируйте в `.env` и при необходимости измените значения.
# Реальные секреты не должны попадать в репозиторий.

# Пароль Postgres (primary и standby-реплика, а также пользователь postgres бэкенда).
POSTGRES_PASSWORD=secret

# Пароль read-only роли `reader` (создаётся миграцией 014_readonly_role.up.sql),
# используется read-only инстансами бэкенда (backend-read1/backend-read2).
# В docker-compose.yml значение задано как DB_PASSWORD=readpass.
# READONLY_DB_PASSWORD=readpass

# Доступ к /admin (Adminer) ограничен HTTP Basic Auth.
# Учётные данные по умолчанию: admin / secret (хеш — в deploy/.htpasswd).
# Для смены пароля перегенерируйте хеш: openssl passwd -apr1 "<password>"

# Пароль роли `replicator` для стриминговой репликации совпадает с POSTGRES_PASSWORD
# (в docker-compose.yml: REPLICATION_PASSWORD=${POSTGRES_PASSWORD:-secret}).

# Grafana (за /monitoring): логин/пароль по умолчанию admin/admin.
