# Пример файла с секретами E2E-тестов ЛР №5 (godog/BDD).
#
# Как использовать локально:
#   1. cp .env.e2e.example .env.e2e
#   2. Поменяйте пароль на свой (нужен только вам, репозиторий его не видит —
#      файл в .gitignore).
#   3. make e2e-bdd — цель сама подхватит переменные из этого файла.
#
# В CI пароль задаётся GitHub Actions secret'ом E2E_TECH_USER_PASSWORD
# (Settings → Secrets and variables → Actions → New repository secret).
E2E_TECH_USER_PASSWORD=S3Drxp-password
