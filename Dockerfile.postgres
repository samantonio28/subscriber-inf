# Образ PostgreSQL для тестового стенда (требование ЛР №2 п.4: инстанс хранилища
# «из образа, который будет идентичен при каждом запуске тестов»).
#
# Миграции (migrations/*.sql) запечены в образ: при первом старте свежего
# контейнера /docker-entrypoint-initdb.d применяет их автоматически, поэтому
# схема БД всегда одинаковая и воспроизводимая.
FROM postgres:15-alpine

COPY migrations/ /docker-entrypoint-initdb.d/
