BEGIN;

-- Create enum for promocode status (if not exists) using DO block for idempotency
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'promocode_status') THEN
        CREATE TYPE promocode_status AS ENUM ('ACTIVE', 'USED', 'DISABLED');
    END IF;
END
$$;

-- Add columns to promocodes table (if not exist)
ALTER TABLE promocodes
ADD COLUMN IF NOT EXISTS created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
ADD COLUMN IF NOT EXISTS discount INTEGER NOT NULL DEFAULT 0,
ADD COLUMN IF NOT EXISTS max_uses INTEGER NOT NULL DEFAULT 1,
ADD COLUMN IF NOT EXISTS cur_uses INTEGER NOT NULL DEFAULT 0,
ADD COLUMN IF NOT EXISTS status promocode_status NOT NULL DEFAULT 'ACTIVE',
ADD COLUMN IF NOT EXISTS duration_days INTEGER; -- nullable, if NULL use default 3 days

-- Create subscription_plans table (if not exists)
CREATE TABLE IF NOT EXISTS subscription_plans (
    plan_id INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    service_id INTEGER NOT NULL REFERENCES services(service_id),
    duration_days INTEGER NOT NULL CHECK (duration_days > 0),
    name VARCHAR(255) NOT NULL,
    price INTEGER NOT NULL CHECK (price > 0),
    UNIQUE (service_id, duration_days, price) -- optional
);

-- Insert existing sub_durations data into subscription_plans, but only if not already present
-- Use a left join to avoid duplicates
INSERT INTO subscription_plans (service_id, duration_days, price)
SELECT sd.service_id, sd.duration_days, 1
FROM sub_durations sd
LEFT JOIN subscription_plans sp ON sd.service_id = sp.service_id AND sd.duration_days = sp.duration_days
WHERE sp.plan_id IS NULL;

-- Add plan_id column to promocodes (if not exists)
ALTER TABLE promocodes
ADD COLUMN IF NOT EXISTS plan_id INTEGER REFERENCES subscription_plans(plan_id);

-- Update existing promocodes to have a plan_id based on sub_duration_days and service_id
-- We'll join with subscription_plans to find matching plan.
UPDATE promocodes p
SET plan_id = sp.plan_id
FROM subscription_plans sp
WHERE sp.service_id = p.service_id AND sp.duration_days = p.sub_duration_days
  AND p.plan_id IS NULL;

-- Now we can drop sub_duration_days column (after ensuring data migrated)
ALTER TABLE promocodes
DROP COLUMN IF EXISTS sub_duration_days;

-- Also drop foreign key to subscriptions.sub_id (we'll keep it for now but make nullable)
-- First drop NOT NULL constraint on sub_id (if exists)
ALTER TABLE promocodes
ALTER COLUMN sub_id DROP NOT NULL;

-- Add check for discount range (0-100)
ALTER TABLE promocodes
DROP CONSTRAINT IF EXISTS discount_range;
ALTER TABLE promocodes
ADD CONSTRAINT discount_range CHECK (discount >= 0 AND discount <= 100);

-- Add check for uses
ALTER TABLE promocodes
DROP CONSTRAINT IF EXISTS uses_check;
ALTER TABLE promocodes
ADD CONSTRAINT uses_check CHECK (cur_uses <= max_uses AND cur_uses >= 0);

-- Add default for duration_days (3 days) if not set
UPDATE promocodes SET duration_days = 3 WHERE duration_days IS NULL;
ALTER TABLE promocodes
ALTER COLUMN duration_days SET DEFAULT 3;

-- Ensure duration_days is NOT NULL
ALTER TABLE promocodes
ALTER COLUMN duration_days SET NOT NULL;

COMMIT;